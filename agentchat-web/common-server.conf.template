# 共享 server 配置（HTTP:80 与 HTTPS:443 共用；由 nginx envsubst 从 templates 生成）
    root /usr/share/nginx/html;
    # 传输硬上限；附件实际大小限制由后端按管理页 upload_max_mb 动态执行（返回明确错误）
    client_max_body_size ${NGINX_MAX_BODY};

    # 入口不缓存（其中引用带 hash 的资产文件名，发布后浏览器立即拿到新版本）；
    # 带 hash 的资产可永久缓存
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location /api/ws {
        proxy_pass http://agentchat-server:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }

    # 附件反代：上游由部署配置决定（FILES_READ_UPSTREAM 注入）
    location /files/ {
        proxy_pass ${FILES_READ_UPSTREAM};
        proxy_read_timeout ${NGINX_TIMEOUT};
    }

    # MCP 端点：POST/GET /mcp（streamable HTTP，可能长连接推流）
    # 有了它，对外就只需要 agentchat-web 这一个端口（/api、/ws、/mcp 全部同源反代）
    location /mcp {
        proxy_pass http://agentchat-server:8000;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout ${NGINX_TIMEOUT};
    }

    location /api/ {
        proxy_pass http://agentchat-server:8000;
        proxy_read_timeout ${NGINX_TIMEOUT};
        proxy_send_timeout ${NGINX_TIMEOUT};
    }
