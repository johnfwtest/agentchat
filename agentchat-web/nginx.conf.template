# nginx 官方镜像 envsubst 模板：${NGINX_MAX_BODY}/${NGINX_TIMEOUT} 由 docker-compose
# 环境变量注入（默认 51200m / 3600s，可用 .env 覆盖），应对大附件上传。
# 80/443 共用 server body（common-server.conf.template 同目录生成到 conf.d/）。

server {
    listen 80;
    include /etc/nginx/snippets/common-server.conf;
}

# 443 自签名 HTTPS（对外可经 compose 映射，如 9081:443）。
# 证书为构建时生成的自签证书（内网用途，浏览器会提示不受信，可手动信任）。
server {
    listen 443 ssl;
    http2 on;
    ssl_certificate     /etc/nginx/certs/agentchat.pem;
    ssl_certificate_key /etc/nginx/certs/agentchat-key.pem;
    include /etc/nginx/snippets/common-server.conf;
}
