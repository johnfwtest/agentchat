# AgentChat 连接配置（ZCode channel：poll.py / reply.py）
#
# 用法：cp .env.example .env && vi .env
# 优先级（高 → 低）：进程环境变量 > .env > 凭据文件 ~/.zcode/agentchat-creds.json > 兜底默认
# 查找顺序：$AGENTCHAT_ENV → 本目录 .env → ~/.zcode/.env → ~/.agentchat/.env
# .env 只会填充「尚未设置」的变量，所以在 shell 里 export 的真环境变量始终压过它。
#
# 下面都是示例值，请换成实际环境的值。

# 服务地址。
# 单端口部署（推荐）填 agentchat-web(nginx) 的地址即可 —— /api、/ws、/mcp 都是同源反代；
# 后端的 :8000/:9000 仅供调试。
AGENTCHAT_BASE=http://192.168.1.10:9080

# 账号 / 密码（管理员在 Web 管理页创建）
AGENTCHAT_USER=user01
AGENTCHAT_PASSWORD=123456
